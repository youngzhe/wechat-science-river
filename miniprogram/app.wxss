page { min-height: 100%; background: #f6efe0; color: #26364a; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
button { border: 0; font-family: inherit; }
button::after { border: 0; }
.paper { background: rgba(250, 247, 239, .94); border: 1rpx solid rgba(96, 80, 57, .16); border-radius: 28rpx; box-shadow: 0 14rpx 42rpx rgba(53, 39, 23, .12); }
.primary { color: #fffaf0; background: #31546a; border-radius: 999rpx; font-weight: 700; }
.secondary { color: #31546a; background: #e4eee9; border-radius: 999rpx; font-weight: 650; }
.eyebrow { color: #b16e3d; font-size: 22rpx; letter-spacing: 3rpx; font-weight: 700; }
