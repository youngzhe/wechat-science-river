.mascot-root { display: block; width: 100%; height: 100%; transform-origin: center bottom; animation: mascot-bob 3.2s ease-in-out infinite; }
.mascot-image { display: block; width: 100%; height: 100%; }
.mascot-turned { animation: mascot-turn .9s ease-in-out; }
.mascot-compact { animation-duration: 3.6s; }
@keyframes mascot-bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-5rpx); } }
@keyframes mascot-turn { 0% { transform: perspective(600rpx) rotateY(0) scale(1); } 45% { transform: perspective(600rpx) rotateY(78deg) scale(.94); } 100% { transform: perspective(600rpx) rotateY(0) scale(1); } }
