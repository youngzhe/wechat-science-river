<view class="study-shell">
  <view class="scene-stage">
    <image class="room-art" src="/assets/study-room.jpg" mode="aspectFill" />
    <view class="room-wash"></view>
    <view class="top-tools">
      <view class="top-left">
        <text class="chapter-pill">第一章 · 调查书房</text>
        <view class="progress-dots"><view wx:for="{{progressDots}}" wx:key="*this" class="progress-dot {{item ? 'filled' : ''}}"></view></view>
      </view>
      <view class="top-actions"><button class="tool-button sound-btn" bindtap="toggleSound" aria-label="切换声音">{{muted ? '🔇' : '🔈'}}</button><button class="tool-button" bindtap="requestHint">找小助手</button><button class="tool-button" bindtap="openNotebook">笔记 {{observationCount}}</button></view>
    </view>
    <button class="hotspot window-spot {{inspected.window ? 'seen' : ''}} {{guidedObjects ? 'guided' : ''}}" data-object="window" bindtap="inspect"><view class="hotspot-visual">{{inspected.window ? '✓' : '光'}}</view></button>
    <button class="hotspot prism-spot {{inspected.prism ? 'seen' : ''}} {{guidedObjects ? 'guided' : ''}}" data-object="prism" bindtap="inspect"><view class="hotspot-visual">{{inspected.prism ? '✓' : '◇'}}</view></button>
    <button class="hotspot screen-spot {{inspected.screen ? 'seen' : ''}} {{guidedObjects ? 'guided' : ''}}" data-object="screen" bindtap="inspect"><view class="hotspot-visual">{{inspected.screen ? '✓' : '□'}}</view></button>
    <button class="hotspot paper-spot {{inspected.manuscript ? 'seen' : ''}} {{guidedObjects ? 'guided' : ''}}" data-object="manuscript" bindtap="inspect"><view class="hotspot-visual">{{inspected.manuscript ? '✓' : '手稿'}}</view></button>
  </view>
  <view class="study-panel paper">
    <view class="task-row"><text class="task-eyebrow">当前任务</text><text class="task-text">找到这道彩光留下的线索</text></view>
    <view class="dialogue" wx:if="{{!dialogueHidden}}">
      <mascot class="buddy" compact />
      <view class="dialogue-copy"><text class="buddy-name">小墨团</text><text class="buddy-line">{{dialogue}}</text></view>
      <button class="dialogue-close" bindtap="hideDialogue" aria-label="收起对话">×</button>
    </view>
    <button class="buddy-reopen" wx:if="{{dialogueHidden}}" bindtap="showDialogue" aria-label="展开小墨团对话"><mascot compact /></button>
    <view class="hypothesis-box" wx:if="{{allInspected}}">
      <text class="hypothesis-eyebrow">你现在怎么想？稍后可以修改</text>
      <view class="hypothesis-list">
        <button wx:for="{{hypotheses}}" wx:key="id" class="hypothesis {{currentHypothesis === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="chooseHypothesis">{{item.title}}</button>
      </view>
    </view>
    <button class="primary continue-button" wx:if="{{allInspected && currentHypothesis}}" bindtap="startLab">试试棱镜 <text>→</text></button>
  </view>
  <view class="clue-layer" wx:if="{{activeClue}}" bindtap="closeClue">
    <view class="clue-card paper" catchtap="stopTap">
      <view class="clue-head"><text class="clue-title">{{activeClue.title}}</text><button class="close-clue" bindtap="closeClue">×</button></view>
      <text class="clue-copy">{{activeClue.copy}}</text>
      <text class="clue-tap-hint">点击空白处关闭</text>
    </view>
  </view>
  <view class="intro-backdrop" wx:if="{{introOpen}}">
    <view class="intro-card paper"><mascot class="intro-buddy" compact /> <text class="eyebrow">穿越笔记 · 一道彩光</text><text class="intro-title">先别急着找答案</text><text class="intro-copy">小墨团追着一道光钻进笔记。醒来时，书房里只剩一束白光和一份缺了结论的档案。帮我们调查：颜色是棱镜带来的，还是白光本来就有的？</text><button class="primary intro-button" bindtap="enterRoom">开始调查</button><button class="intro-skip" bindtap="enterRoom">跳过说明，直接调查</button><text class="fiction-note">穿越与书房失色是虚构情节。</text></view>
  </view>
  <view class="hint-backdrop" wx:if="{{showHint}}" bindtap="closeHint" catchtouchmove="stopTap"><view class="hint-card paper" catchtap="stopTap"><view class="hint-header"><text class="eyebrow">小墨团 · 第 {{hintLevel}} 层提示</text><button class="close-clue" bindtap="closeHint">×</button></view><text class="hint-text">{{hintText}}</text><view class="hint-actions"><button class="secondary" bindtap="closeHint">我再试试</button><button class="primary" bindtap="deeperHint">再具体一点</button></view></view></view>
</view>
