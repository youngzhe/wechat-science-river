.home-shell { position:relative; height:100vh; overflow:hidden; background:#694726; }
.world-art { position:absolute; inset:0; width:100%; height:100%; }

/* 顶部品牌 + 吉祥物 */
.world-header {
  position:absolute; left:34rpx; right:30rpx; height:255rpx;
  display:flex; align-items:center; z-index:2; pointer-events:none;
}
.world-brand {
  padding:15rpx 22rpx; color:#214955; background:rgba(255,235,190,.94);
  border:2rpx solid #b18a53; border-radius:12rpx;
  box-shadow:0 6rpx 22rpx rgba(34,19,6,.2);
}
.world-title { display:block; font-family:'Songti SC',serif; font-size:52rpx; font-weight:800; letter-spacing:2rpx; line-height:1.15; }
.world-subtitle { display:block; font-family:'Songti SC',serif; font-size:33rpx; font-weight:700; margin-top:4rpx; }
.world-invitation { display:block; font-size:21rpx; margin-top:12rpx; color:#78532f; }
.world-mascot {
  width:250rpx; height:258rpx; margin-left:4rpx; pointer-events:auto;
  filter:drop-shadow(0 10rpx 12rpx rgba(32,18,6,.4));
}

/* 声音开关 */
.sound-switch {
  position:absolute; right:25rpx; z-index:3;
  width:64rpx !important; min-width:64rpx !important; height:64rpx !important;
  margin:0; padding:0 !important; border-radius:50%;
  background:rgba(37,30,23,.8); line-height:1;
  display:flex; align-items:center; justify-content:center;
}
.sound-switch .sound-icon { width:34rpx !important; height:34rpx !important; flex:none; }

/* 地图主区：flex 列布局，按主章节居中、三区域卡分布在它上下 */
.map-content {
  position:absolute;
  left:0; right:0; top:calc(280rpx + env(safe-area-inset-top));
  bottom:calc(180rpx + env(safe-area-inset-bottom));
  display:flex; flex-direction:column;
  align-items:stretch; justify-content:space-between;
  padding:24rpx 36rpx;
  box-sizing:border-box;
}

/* 三个区域卡作为一组，等高可点 */
.region-row { display:flex; justify-content:space-between; gap:24rpx; }
.region-row.row-bottom { justify-content:space-between; }

.region-node {
  display:flex !important; flex-direction:column; align-items:center;
  margin:0 !important; padding:14rpx 22rpx !important; line-height:1.35;
  width:fit-content !important; min-width:0 !important; max-width:46%;
  color:#5c452d; font-size:26rpx; font-weight:650;
  background:rgba(250,230,187,.96);
  border:2rpx solid #ae854c; border-radius:14rpx;
  box-shadow:0 5rpx 12rpx rgba(71,44,14,.18);
}
.region-state { font-size:18rpx; margin-top:3rpx; color:#856b4c; }

/* 主章节卡 + 进度条 */
.active-block {
  display:flex; flex-direction:column; gap:18rpx; padding:0 6rpx;
}
.active-node {
  width:100% !important; box-sizing:border-box;
  margin:0 !important; padding:18rpx 18rpx !important;
  border-radius:20rpx; line-height:1.3;
  color:#fff7db; background:rgba(22,64,79,.96);
  border:2rpx solid #e3b463;
  box-shadow:0 5rpx 18rpx rgba(20,35,31,.25);
}
.node-overline { display:block; font-size:19rpx; color:#e7c58d; }
.node-title { display:block; font-size:35rpx; font-family:'Songti SC',serif; font-weight:750; margin:6rpx 0; }
.node-status { display:block; font-size:19rpx; }
.chapter-progress {
  box-sizing:border-box; padding:14rpx 18rpx 16rpx;
  border-radius:17rpx;
  background:rgba(25,63,74,.95); border:2rpx solid #b89257;
  text-align:center; color:#f7e8c6; font-size:20rpx; line-height:1.45;
}
.progress-track { height:8rpx; overflow:hidden; background:rgba(158,141,113,.33); border-radius:999rpx; margin:12rpx 0; }
.progress-track view { height:100%; background:#dba94b; border-radius:999rpx; transition:width .3s ease; }
.start-button {
  display:block; width:100% !important; box-sizing:border-box;
  margin:0 !important; padding:12rpx 6rpx !important;
  min-height:76rpx; line-height:1.4; border-radius:15rpx;
  color:#53330f; background:#f0c772; font-size:28rpx; font-weight:750;
  box-shadow:inset 0 0 0 2rpx #d09c42;
}
.start-button .start-arrow { margin-left:6rpx; }

/* 底部木质导航 */
.wood-nav {
  position:absolute; z-index:8; left:0; right:0; bottom:0;
  display:flex; height:164rpx; background:#432918;
  padding-bottom:env(safe-area-inset-bottom);
}
.wood-texture { position:absolute; inset:0; width:100%; height:100%; }
.wood-tab {
  position:relative; flex:1; min-width:0;
  margin:0; padding:24rpx 4rpx 14rpx;
  background:transparent; display:flex; align-items:center; flex-direction:column;
  justify-content:flex-start; line-height:1.25; font-size:23rpx; color:#dfc198;
  border:0; border-radius:0;
}
.wood-tab .tab-icon { width:46rpx; height:46rpx; margin-bottom:6rpx; }
.wood-tab text { white-space:nowrap; }
.wood-tab.selected {
  color:#ffe29c; text-shadow:0 0 18rpx #d99731;
  background:rgba(236,166,54,.12); box-shadow:inset 0 -4rpx #e7b858;
}
.wood-tab.selected .tab-icon { filter:drop-shadow(0 0 7rpx #ba7620); }

/* 图书馆视图 */
.library-view {
  position:absolute;
  left:24rpx; right:24rpx;
  bottom:calc(178rpx + env(safe-area-inset-bottom));
  display:flex; flex-direction:column;
  background:rgba(250,242,225,.97);
  border:2rpx solid #c9a77a; border-radius:24rpx;
  overflow:hidden; box-shadow:0 10rpx 32rpx rgba(40,22,6,.3);
}
.library-heading { padding:28rpx 28rpx 22rpx; border-bottom:1rpx solid #ddcfb8; }
.library-kicker { display:block; color:#956633; font-size:19rpx; letter-spacing:1rpx; }
.library-title { display:block; color:#2b4653; font-family:'Songti SC',serif; font-size:43rpx; font-weight:750; margin:9rpx 0; }
.library-subtitle { display:block; color:#82715a; font-size:23rpx; line-height:1.5; }
.library-scroll { flex:1; min-height:0; }

.discovery-row {
  display:block; width:100% !important; box-sizing:border-box;
  margin:0 !important; padding:26rpx 28rpx !important; border-radius:0;
  border-bottom:1rpx solid #ded1bb;
  text-align:left; background:transparent; line-height:1.5;
}
.discovery-heading { font-size:29rpx; font-weight:700; color:#34586a; }
.row-title { display:block; font-size:28rpx; font-weight:650; color:#314b54; line-height:1.4; }
.row-meta { display:block; font-size:21rpx; font-weight:400; color:#857660; margin-top:6rpx; line-height:1.5; }
.discovery-copy { display:block; font-size:25rpx; color:#5a665f; margin-top:13rpx; }
.row-link { display:block; color:#3b797a; font-size:21rpx; margin-top:12rpx; }

.atlas-row {
  display:flex; justify-content:space-between; align-items:center; gap:16rpx;
  width:100% !important; box-sizing:border-box;
  margin:0 !important; padding:29rpx 28rpx !important;
  border-radius:0; border-bottom:1rpx solid #ded1bb;
  background:transparent; text-align:left;
}
.atlas-status { font-size:21rpx; color:#3d7a79; flex-shrink:0; }
.atlas-locked .row-title, .atlas-locked .atlas-status { color:#918674; }

.empty-state { padding:28rpx; text-align:center; font-size:25rpx; color:#7c725f; line-height:1.7; }
.empty-mascot { display:block; width:200rpx; height:205rpx; margin:0 auto 18rpx; }
.empty-title { display:block; font-size:29rpx; color:#355564; font-weight:650; margin-bottom:9rpx; }

.panel-cta {
  display:block; width:calc(100% - 56rpx) !important; box-sizing:border-box;
  margin:24rpx 28rpx !important; min-height:84rpx; line-height:1.5;
  padding:21rpx 14rpx !important; font-size:25rpx;
}

.journey-summary { padding:25rpx 28rpx 12rpx; }
.journey-step {
  display:flex; gap:18rpx; align-items:center;
  margin:0 28rpx; padding:22rpx 0;
  border-bottom:1rpx solid #ded1bb;
}
.journey-step view { flex:1; min-width:0; }
.step-number { width:43rpx; flex-shrink:0; color:#a08b6a; font-size:29rpx; text-align:center; }
.step-done .step-number { color:#488276; }
.step-current .row-title { color:#a76b29; }
.step-state { flex-shrink:0; color:#9c896a; font-size:18rpx; }

.footnote { display:block; padding:23rpx 28rpx 28rpx; color:#9c8d76; font-size:21rpx; line-height:1.5; }

/* 邀请卡片 / 详情卡片 */
.modal-backdrop {
  position:fixed; inset:0; z-index:30;
  background:rgba(28,23,18,.67); padding:34rpx;
  display:flex; align-items:center; justify-content:center;
}
.invitation-card, .detail-card {
  position:relative; width:100%; box-sizing:border-box;
  padding:32rpx; max-height:80vh; overflow:auto;
}
.modal-close {
  position:absolute; top:16rpx; right:16rpx;
  margin:0 !important; padding:0 !important;
  width:64rpx !important; min-width:64rpx !important; height:64rpx;
  line-height:60rpx; font-size:36rpx; border-radius:50%;
  color:#5c594d; background:#e9dfcd;
}
.modal-close.inline-close { position:static; }
.invitation-mascot { display:block; width:190rpx; height:195rpx; margin:0 auto 12rpx; }
.modal-copy { display:block; margin:17rpx 0 0; font-size:27rpx; line-height:1.7; color:#606d68; }
.detail-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:15rpx; }

/* 出发动画 */
.home-shell.departing { animation:enter-chapter .34s ease-in both; pointer-events:none; }
@keyframes enter-chapter { to { opacity:.15; transform:scale(1.04); } }

/* 小屏适配：640px 以下进一步压缩 */
@media (max-height: 680rpx) {
  .world-header { height:200rpx; }
  .world-mascot { width:200rpx; height:208rpx; }
  .map-content { top:calc(220rpx + env(safe-area-inset-top)); padding:18rpx 28rpx; }
  .active-node { padding:14rpx 16rpx !important; }
  .node-title { font-size:30rpx; }
}
