.home-shell { position: relative; height: calc(100vh - 88rpx); min-height: 1100rpx; overflow: hidden; background: #d4b98f; }
.home-bg { position: absolute; inset: 0; width: 100%; height: 100%; animation: home-drift 18s ease-in-out infinite alternate; transform: scale(1.04); }
.home-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(24,34,43,.13) 0%, rgba(28,37,45,.12) 32%, rgba(29,39,44,.82) 72%, #1d292d 100%); }
.map-mark { position: absolute; top: 48rpx; left: 36rpx; padding: 18rpx 22rpx; background: rgba(250,247,239,.92); }
.map-caption { display: block; margin-top: 8rpx; font-size: 23rpx; color: #425465; }
.home-copy { position: absolute; top: 38%; left: 44rpx; right: 40rpx; color: #fff9ec; display: flex; flex-direction: column; }
.home-copy .eyebrow { color: #f4ca8a; }
.hero-title { margin-top: 18rpx; font-size: 78rpx; line-height: 1.2; font-weight: 800; letter-spacing: 2rpx; white-space: pre-line; text-shadow: 0 6rpx 20rpx rgba(20,20,18,.28); }
.hero-title-accent { color: #f8cd84; }
.hero-subtitle { margin-top: 20rpx; max-width: 610rpx; font-size: 28rpx; line-height: 1.7; color: rgba(255,249,236,.88); }
.chapter-chip { display: flex; align-items: center; align-self: flex-start; margin-top: 24rpx; padding: 12rpx 18rpx; border: 1rpx solid rgba(255,246,225,.32); border-radius: 999rpx; color: #fff5e2; font-size: 22rpx; background: rgba(16,31,39,.25); }
.chip-dot { width: 12rpx; height: 12rpx; margin-right: 12rpx; border-radius: 50%; background: #ffc76d; box-shadow: 0 0 16rpx #ffc76d; }
.home-mascot { position: absolute; width: 206rpx; height: 214rpx; right: 24rpx; bottom: 334rpx; filter: drop-shadow(0 14rpx 14rpx rgba(13,21,25,.28)); }
.home-footer { position: absolute; left: 32rpx; right: 32rpx; bottom: 26rpx; padding-bottom: env(safe-area-inset-bottom); }
.footer-top-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.sound-toggle { margin: 0; flex-shrink: 0; width: 76rpx; height: 76rpx; line-height: 76rpx; padding: 0; border-radius: 50%; background: rgba(35,48,53,.6); color: #fff7e9; font-size: 32rpx; }
.locked-node { display: flex; align-items: center; gap: 20rpx; padding: 0 8rpx 24rpx; color: #f0e2c8; }
.node-ring { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border-radius: 50%; border: 1rpx solid rgba(244,220,180,.52); color: #f2d8ad; }
.node-title, .node-caption { display: block; }
.node-title { font-size: 25rpx; }
.node-caption { margin-top: 7rpx; font-size: 20rpx; color: rgba(242,226,200,.68); }
.start-button { height: 94rpx; line-height: 94rpx; font-size: 30rpx; letter-spacing: 1rpx; box-shadow: 0 14rpx 28rpx rgba(10,20,27,.28); }
.footer-note { display: block; margin-top: 13rpx; text-align: center; color: rgba(249,239,218,.68); font-size: 20rpx; }
@keyframes bob { 0%,100% { transform: translateY(0) rotate(1deg); } 50% { transform: translateY(-12rpx) rotate(-1deg); } }
@keyframes home-drift { from { transform: scale(1.04) translate3d(0,0,0); } to { transform: scale(1.10) translate3d(-5rpx,-4rpx,0); } }
